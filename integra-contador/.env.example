# Token compartilhado exigido em toda requisição (header X-Internal-Token),
# mesmo padrão do backend/nfse-engine.
INTEGRA_CONTADOR_INTERNAL_TOKEN=

# Mesmo projeto Supabase do soma-nfse/frontend — leitura da linha da SOMA em
# `certificates` e das tabelas próprias deste serviço (integra_contador_*).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Precisa ser o MESMO valor configurado em soma-nfse/frontend
# (MASTER_ENCRYPTION_KEY) — é a chave que decifra o certificado da SOMA
# guardado em `certificates`. Ver frontend/src/lib/certificate.ts.
MASTER_ENCRYPTION_KEY=

# UUID da linha da própria SOMA em public.companies (a organization/company
# especial da SOMA — ver supabase/migrations/20260818120000_fase_a_fundacao.sql).
SOMA_COMPANY_ID=

# CNPJ da SOMA (só dígitos) — usado como contratante/autorPedidoDados em toda
# chamada ao Integra Contador.
SOMA_CNPJ=

# Credenciais do contrato Integra Contador na loja Serpro
# (https://cliente.serpro.gov.br).
INTEGRA_CONTADOR_CONSUMER_KEY=
INTEGRA_CONTADOR_CONSUMER_SECRET=

# Trocar pelo endpoint de demonstração/trial durante o desenvolvimento, pra
# não gastar chamada de produção enquanto testa.
INTEGRA_CONTADOR_AUTH_URL=https://autenticacao.sapi.serpro.gov.br/authenticate
INTEGRA_CONTADOR_GATEWAY_URL=https://gateway.apiserpro.serpro.gov.br/integra-contador/v1

# API Consulta CND — produto SEPARADO do Integra Contador (contrato e
# credenciais próprios, sem certificado digital, só Consumer Key/Secret).
# Deixe vazio até contratar em https://www.loja.serpro.gov.br/consultacnd —
# sem essas duas, /contribuintes/{cnpj}/cnd usa o ambiente de demonstração
# gratuito (dados fictícios) com o token de exemplo público da doc.
CND_CONSUMER_KEY=
CND_CONSUMER_SECRET=
CND_TOKEN_URL=https://gateway.apiserpro.serpro.gov.br/token
# Trocar pra .../consulta-cnd/v1/certidao (sem "-trial") assim que o
# contrato de produção estiver ativo.
CND_GATEWAY_URL=https://gateway.apiserpro.serpro.gov.br/consulta-cnd-trial/v1/certidao
