# Token compartilhado exigido em toda requisição (header X-Internal-Token),
# mesmo padrão do integra-contador/nota-carioca-service.
WHATSAPP_CONNECTOR_INTERNAL_TOKEN=

# Mesmo projeto Supabase do soma-nfse/frontend — este serviço escreve
# direto em atendimento_contatos/atendimento_tickets/atendimento_mensagens
# com a service role (ignora RLS de propósito: não há sessão de usuário
# aqui, é um processo sempre-ativo reagindo a evento do WhatsApp — mesmo
# raciocínio do integra-contador/supabase_client.py).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# UUID da linha em atendimento_conexoes que este processo representa.
# Um processo = uma conexão = um número de WhatsApp (ver README.md).
ATENDIMENTO_CONEXAO_ID=

# Pasta onde o Baileys guarda a sessão pareada (multi-file auth state) —
# em produção (Railway) deve apontar para dentro de um Volume, senão a
# sessão se perde a cada deploy e pede novo QR Code. NUNCA versionar essa
# pasta nem gravá-la em lugar nenhum do Supabase/Postgres.
BAILEYS_AUTH_DIR=./auth_info_baileys

# Mesmo Blob store do soma-nfse/frontend (copiar o valor de lá) — mídia
# recebida (foto, áudio, vídeo, figurinha, documento) é baixada do
# WhatsApp e guardada aqui, privada, mesmo padrão de Legalização.
BLOB_READ_WRITE_TOKEN=

PORT=3333
